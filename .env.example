# ─── ตัวอย่าง environment variables ───────────────────────────────
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง:   cp .env.example .env
# ห้าม commit ไฟล์ .env ขึ้น git (ถูก gitignore ไว้แล้ว)

# PostgreSQL connection string
# รูปแบบ: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# บน VPS ที่ติดตั้ง Postgres ในเครื่องเดียวกัน HOST = localhost
PRISMA_DATABASE_URL="postgresql://sup_user:CHANGE_ME@localhost:5432/sup_space"

# รหัสผ่านสำหรับเข้าหน้า /admin (ตั้งให้เดายาก)
ADMIN_PASSWORD="CHANGE_ME_to_a_strong_password"

# คีย์ลับสำหรับเซ็น session token ของหน้า /admin (สุ่มยาว ๆ เช่น `openssl rand -hex 32`)
# ถ้าไม่ตั้ง ระบบจะ fallback ไปใช้ ADMIN_PASSWORD แทน — แต่แนะนำให้ตั้งแยกต่างหาก
SESSION_SECRET=""

# Google Places API — สำหรับดึงรีวิว/เรตติ้งจาก Google
# ขอ API key ที่ https://console.cloud.google.com (เปิด Places API)
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""

# Booking API key — ใช้ยืนยันตัวตนสำหรับ POST /api/booking (AI chatbot)
# สร้างด้วย:  openssl rand -hex 32
# ถ้าไม่ตั้ง API จะ return 503 (disabled)
BOOKING_API_KEY=""

# Resend — ส่ง email แจ้งว่าได้รับการจองแล้ว (เว้นว่างเพื่อปิดการส่ง email)
RESEND_API_KEY=""
# ต้องเป็น sender/domain ที่ verify ใน Resend; ถ้าไม่ตั้งจะใช้ booking@supspacemaeklong.com
RESEND_FROM_EMAIL="booking@supspacemaeklong.com"
