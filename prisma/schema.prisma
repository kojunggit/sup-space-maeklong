datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Setting {
  key   String @id
  value String
}

model User {
  id       String    @id @default(cuid())
  name     String?
  email    String?   @unique
  image    String?
  role     String    @default("USER")
  bookings Booking[]
}

model Booking {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  guestName       String?
  guestPhone      String?
  contactChannel  String?  // line | whatsapp | messenger
  contactId       String?  // ID/username on that platform
  date            String
  dateIso         String?  // ISO "2026-05-23" — used for filtering/sorting upcoming trips
  timeSlot        String
  routeId         String?
  specialTripId   String?  // set when booking a special trip
  boardChoice     String?  // "rental" | "own" — for special trips
  paddlers        Int      @default(1)
  weight          Float?
  skillLevel      String?
  hasPhoto        Boolean  @default(false)
  photoPermission String   @default("allow")  // allow | notAllow | private
  pickupAddress   String?
  notes           String?
  total           Int?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
}

model SpecialTrip {
  id            String   @id @default(cuid())
  name          String
  description   String?
  rentalPrice   Int
  ownBoardPrice Int
  dateIso       String   // "2026-05-28"
  date          String   // "ส. 28 พ.ค." (Thai display)
  timeSlot      String   // "09:00"
  location      String
  maxBoards     Int      @default(8)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
}

// ─── Membership / package system ──────────────────────────────────────────────
// Members are identified by phone number (the membership ID). Each member can
// hold multiple packages over time (renew / buy more). Each visit is logged.

model Member {
  id        String          @id @default(cuid())
  phone     String          @unique          // canonical "0812345678"
  name      String
  email     String?
  channel   String?                          // "line" | "whatsapp" | "messenger"
  contactId String?                          // id/username on that channel
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  packages  MemberPackage[]
  visits    VisitLog[]

  @@index([name])
}

model MemberPackage {
  id         String     @id @default(cuid())
  memberId   String
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type       String                          // "COUNT" | "MONTH"
  status     String     @default("ACTIVE")   // COUNT: ACTIVE|USED_UP|CANCELLED
                                              // MONTH: PENDING|ACTIVE|EXPIRED|CANCELLED
  price      Int                             // 2900 / 3500 (price at purchase)
  totalCount Int?                            // 10 for COUNT, null for MONTH
  usedCount  Int        @default(0)
  startDate  DateTime?                        // null = pending (MONTH not yet started)
  endDate    DateTime?                        // startDate + 1 month
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  visits     VisitLog[]

  @@index([memberId, status])
}

model VisitLog {
  id          String        @id @default(cuid())
  memberId    String
  member      Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  packageId   String
  package     MemberPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageType String                          // snapshot "COUNT" | "MONTH"
  visitNumber Int?                            // COUNT: usedCount after this visit
  via         String        @default("telegram")  // "telegram" | "admin"
  voided      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([memberId, createdAt])
}

model GalleryPhoto {
  id        String   @id @default(cuid())
  src       String   // "/images/KOSI2067.jpg" or "/uploads/<uuid>.jpg"
  caption   String
  category  String?  // "nature" | "market" | "friends" | "pets" | "spots" | null
  big       Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
