datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Setting {
  key   String @id
  value String
}

model User {
  id       String    @id @default(cuid())
  name     String?
  email    String?   @unique
  image    String?
  role     String    @default("USER")
  bookings Booking[]
}

model Booking {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  guestName       String?
  guestPhone      String?
  contactChannel  String?  // line | whatsapp | messenger
  contactId       String?  // ID/username on that platform
  date            String
  dateIso         String?  // ISO "2026-05-23" — used for filtering/sorting upcoming trips
  timeSlot        String
  routeId         String?
  specialTripId   String?  // set when booking a special trip
  boardChoice     String?  // "rental" | "own" — for special trips
  paddlers        Int      @default(1)
  weight          Float?
  skillLevel      String?
  hasPhoto        Boolean  @default(false)
  photoPermission String   @default("allow")  // allow | notAllow | private
  pickupAddress   String?
  notes           String?
  total           Int?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
}

model SpecialTrip {
  id            String   @id @default(cuid())
  name          String
  description   String?
  rentalPrice   Int
  ownBoardPrice Int
  dateIso       String   // "2026-05-28"
  date          String   // "ส. 28 พ.ค." (Thai display)
  timeSlot      String   // "09:00"
  location      String
  maxBoards     Int      @default(8)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
}
