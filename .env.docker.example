# ─── ตัวอย่าง .env สำหรับ Docker (docker compose) ──────────────────────────────
# คัดลอกเป็น .env:   cp .env.docker.example .env   แล้วใส่ค่าจริง
# ห้าม commit .env ขึ้น git (ถูก gitignore ไว้แล้ว)

# รหัสผ่าน Postgres — ใช้ทั้งตอนสร้าง DB container และต่อ DB
# (PRISMA_DATABASE_URL ถูกประกอบให้อัตโนมัติใน docker-compose.yml จากค่านี้)
DB_PASSWORD=CHANGE_ME_strong_db_password

# รหัสผ่านหน้า /admin
ADMIN_PASSWORD=CHANGE_ME_admin_password

# คีย์ลับเซ็น session token ของ /admin — สร้างด้วย: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32

# Google Places (เว้นว่างได้ถ้ายังไม่ใช้รีวิว Google)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
